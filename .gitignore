.cache/

# Desktop packaging stage (generated by desktop/scripts/stage.mjs) and installers
desktop/.stage/
desktop/release/

# Ad-hoc screenshots and scratch scripts from manual testing
screenshots/
*.local.*
# scratch images dropped in the repo root (doc screenshots live in docs/studio/)
/*.png
/*.jpg

# Merge / patch leftovers and backups
*.orig
*.rej
*.bak

# Other package-manager caches
.pnpm-store/
.yarn/

# Local keys and certificates
*.pem
*.key
*.p12
*.pfx
# npm / git credentials (an .npmrc may hold an auth token)
.npmrc
.git-credentials

# Temp files from editors and test scripts
*.tmp
.tmp-*/

# Live-test artifacts that could land outside .tmp/: settings backups, CDP scratch, crash dumps, Electron profiles
*.cellar-*.tmp
*__settings.json
*.dmp
edge-*/
DevToolsActivePort
# Cellar Studio portable / local install trees accidentally created inside the repo
/Cellar Studio/
/CellarStudio/

# More live-test / packaging artifacts: CDP network captures (may hold cookies or tokens), unpacked Electron
# archives, intermediate prototype screenshots, Cellar offline backups made outside a workspace
*.har
*.asar
*.raw.png
backups/

# A Cellar workspace or tavern data accidentally created inside the repo (real cards, books, chats, settings)
/workspace/
/characters/
/lorebooks/
/regex/
/presets/
/cellar.json
/data/
*.jsonl
*.charx

# Node test runner / reporter output and other scratch from manual testing
*.tap
.test-output/
*.img
*.bin
# Redirected stdout/stderr of live-test processes (ST server, companion, Electron) and Cygwin/MSYS crash dumps
*.out
*.err
*.stackdump

# Local AI-agent / tool state
.limcode/
.claude/settings.local.json

# Packaging intermediates wherever electron-builder is pointed, and scratch test homes / workspaces / debug
# folders created at the repo root by live tests (they hold real tavern ids, cards and logs)
win-unpacked/
.stage/
__uninstaller*
/*-home/
/*-ws/
/debug/
/ui*shots/
